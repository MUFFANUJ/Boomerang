    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(boomerang_ingest_duration_seconds_bucket[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(boomerang_ingest_duration_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Consumer lag by group",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
